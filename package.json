{
	"name": "sveltekeleton",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync && (git config core.hooksPath .githooks || true)",
		"dev": "npm run prepare && vite dev --host",
		"build": "npm run prepare && vite build",
		"preview": "npm run build && vite preview --host",
		"deploy": "npm run build && wrangler deploy",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:migrate": "tsx scripts/migrate-db.ts",
		"db:reset": "tsx scripts/reset-db.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260801.1",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.1.2",
		"daisyui": "5.7.14",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.22.0",
		"globals": "17.9.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"tsx": "4.23.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.65.0",
		"vite": "8.2.0",
		"vitest": "4.1.10",
		"vite-plugin-devtools-json": "1.1.0",
		"wrangler": "4.118.0"
	},
	"dependencies": {
		"@humanspeak/svelte-headless-table": "6.0.12",
		"kysely": "0.29.4",
		"kysely-d1": "0.4.0",
		"sveltekit-superforms": "2.30.2",
		"zod": "4.4.3"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260730.1": true,
		"fsevents@2.3.3": true
	}
}
